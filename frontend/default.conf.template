server {
    listen 80;

    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    resolver ${DNS_RESOLVER} valid=10s ipv6=off;
    set $backend_api ${BACKEND_URL};

    location /api/ {
        # El backend expone /materias, no /api/materias: se quita el prefijo.
        # (proxy_pass con variable no lo recorta solo)
        rewrite ^/api/(.*)$ /$1 break;
        proxy_pass $backend_api;
        proxy_ssl_server_name on;
    }
}